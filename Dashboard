<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Railway Track Monitoring System</title>
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@600;700;900&family=Exo+2:wght@400;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #03050d;
      --card:      rgba(8,18,38,0.93);
      --border:    #0f2a4a;
      --cyan:      #00f5ff;
      --cyan-dim:  #00b8c8;
      --purple:    #b400ff;
      --purple-dim:#7a00bb;
      --green:     #00ff88;
      --red:       #ff1e4a;
      --yellow:    #ffda00;
      --white:     #eef6ff;
      --muted:     #3d6585;
      --mono:      'Share Tech Mono', monospace;
      --hud:       'Orbitron', sans-serif;
      --body:      'Exo 2', sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--white);
      font-family: var(--body);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* scanlines */
    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 999;
      pointer-events: none;
      background: repeating-linear-gradient(
        0deg, transparent, transparent 2px,
        rgba(0,0,0,.1) 2px, rgba(0,0,0,.1) 4px
      );
    }

    /* animated grid */
    .bg-grid {
      position: fixed; inset: 0; z-index: 0;
      background-image:
        linear-gradient(rgba(0,245,255,.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,245,255,.03) 1px, transparent 1px);
      background-size: 50px 50px;
      animation: grid-move 22s linear infinite;
    }
    @keyframes grid-move {
      from { background-position: 0 0; }
      to   { background-position: 50px 50px; }
    }

    /* ambient blobs */
    .blob { position: fixed; border-radius: 50%; filter: blur(90px); opacity: .16; pointer-events: none; z-index: 0; }
    .blob-tl { width: 520px; height: 520px; top: -180px; left: -160px; background: var(--purple); animation: drift 8s ease-in-out infinite alternate; }
    .blob-br { width: 620px; height: 620px; bottom: -200px; right: -160px; background: var(--cyan); animation: drift 10s ease-in-out infinite alternate-reverse; }
    @keyframes drift { from{transform:scale(1);} to{transform:scale(1.12);} }

    /* ══ HEADER ══ */
    header {
      position: relative; z-index: 10;
      display: flex; flex-direction: column; align-items: center;
      padding: 30px 24px 20px;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(180deg, rgba(0,245,255,.055) 0%, transparent 100%);
      overflow: hidden;
    }
    header::after {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent 0%, var(--cyan) 30%, var(--purple) 70%, transparent 100%);
      animation: line-glow 3s ease-in-out infinite;
    }
    @keyframes line-glow { 0%,100%{opacity:.5;} 50%{opacity:1;} }

    .header-top { display: flex; align-items: center; gap: 16px; }

    .hud-icon {
      font-size: 2.5rem;
      filter: drop-shadow(0 0 14px var(--cyan));
      animation: icon-pulse 2.8s ease-in-out infinite;
    }
    @keyframes icon-pulse {
      0%,100%{ filter: drop-shadow(0 0 10px var(--cyan)); }
      50%    { filter: drop-shadow(0 0 30px var(--cyan)) drop-shadow(0 0 60px rgba(0,245,255,.35)); }
    }

    header h1 {
      font-family: var(--hud);
      font-size: clamp(1rem, 2.6vw, 1.65rem);
      font-weight: 900;
      letter-spacing: .09em;
      text-transform: uppercase;
      background: linear-gradient(90deg, #fff 15%, var(--cyan) 55%, var(--purple) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .header-sub {
      margin-top: 8px;
      font-family: var(--mono);
      font-size: .68rem; font-weight: 700;
      color: var(--muted);
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    .live-row { display: flex; gap: 28px; align-items: center; margin-top: 12px; flex-wrap: wrap; justify-content: center; }

    .live-badge {
      display: flex; align-items: center; gap: 7px;
      font-family: var(--mono); font-size: .7rem; font-weight: 700;
      color: var(--green); letter-spacing: .15em;
    }
    .live-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--green); box-shadow: 0 0 8px var(--green);
      animation: blink 1.2s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.15;} }

    .sys-chip {
      font-family: var(--mono); font-size: .67rem; font-weight: 700;
      color: var(--muted); letter-spacing: .12em;
      padding: 2px 10px;
      border: 1px solid var(--border);
      border-radius: 2px;
    }
    .sys-chip span { color: var(--cyan-dim); }

    /* ══ MAIN GRID ══ */
    main {
      position: relative; z-index: 5;
      max-width: 1240px;
      margin: 0 auto;
      padding: 26px 20px 56px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .span-3 { grid-column: 1 / -1; }
    .span-2 { grid-column: span 2; }

    /* ══ CARD ══ */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 20px 22px;
      position: relative;
      backdrop-filter: blur(16px);
      box-shadow: 0 2px 0 rgba(0,245,255,.04) inset, 0 10px 40px rgba(0,0,0,.55);
      transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
      opacity: 0;
      transform: translateY(14px);
      animation: fadein .5s ease forwards;
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: rgba(0,245,255,.25);
      box-shadow: 0 0 24px rgba(0,245,255,.07), 0 14px 50px rgba(0,0,0,.5);
    }
    /* HUD corner brackets */
    .card::before,.card::after {
      content:''; position:absolute;
      width:14px; height:14px;
      border-color: var(--cyan); border-style: solid; opacity: .55;
    }
    .card::before { top:-1px; left:-1px; border-width:2px 0 0 2px; }
    .card::after  { bottom:-1px; right:-1px; border-width:0 2px 2px 0; }

    .card:nth-child(1){animation-delay:.04s}
    .card:nth-child(2){animation-delay:.10s}
    .card:nth-child(3){animation-delay:.16s}
    .card:nth-child(4){animation-delay:.22s}
    .card:nth-child(5){animation-delay:.28s}
    .card:nth-child(6){animation-delay:.34s}
    .card:nth-child(7){animation-delay:.40s}
    .card:nth-child(8){animation-delay:.46s}
    @keyframes fadein { to { opacity:1; transform:translateY(0); } }

    /* card label */
    .card-label {
      font-family: var(--mono);
      font-size: .62rem; font-weight: 700;
      color: var(--cyan-dim);
      letter-spacing: .22em;
      text-transform: uppercase;
      margin-bottom: 16px;
      display: flex; align-items: center; gap: 8px;
    }
    .card-label::after {
      content:''; flex:1; height:1px;
      background: linear-gradient(90deg, rgba(0,245,255,.22), transparent);
    }

    /* ══ STATUS ══ */
    .status-card { text-align: center; padding: 28px 28px 24px; }
    .status-bg-ok  { background: radial-gradient(ellipse at 50% 0%, rgba(0,255,136,.08) 0%, transparent 60%); }
    .status-bg-err { background: radial-gradient(ellipse at 50% 0%, rgba(255,30,74,.1) 0%, transparent 60%); }

    .status-eyebrow {
      font-family: var(--hud);
      font-size: .58rem; font-weight: 700;
      color: var(--muted); letter-spacing: .28em;
      text-transform: uppercase; margin-bottom: 14px;
    }

    .status-display {
      display: inline-flex; align-items: center; gap: 14px;
      padding: 14px 38px;
      border-radius: 3px;
      font-family: var(--hud);
      font-size: clamp(1rem, 2.2vw, 1.6rem);
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
      border: 2px solid;
      margin-bottom: 14px;
      position: relative; overflow: hidden;
    }
    .status-display::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.05) 0%, transparent 55%);
    }

    .s-ok {
      color: var(--green); border-color: var(--green);
      text-shadow: 0 0 18px rgba(0,255,136,.7);
      box-shadow: 0 0 32px rgba(0,255,136,.18), inset 0 0 28px rgba(0,255,136,.05);
    }
    .s-err {
      color: var(--red); border-color: var(--red);
      text-shadow: 0 0 18px rgba(255,30,74,.7);
      box-shadow: 0 0 32px rgba(255,30,74,.22), inset 0 0 28px rgba(255,30,74,.07);
      animation: err-flare 1.5s ease-in-out infinite;
    }
    @keyframes err-flare {
      0%,100%{ box-shadow: 0 0 32px rgba(255,30,74,.22), inset 0 0 28px rgba(255,30,74,.07); }
      50%    { box-shadow: 0 0 64px rgba(255,30,74,.5),  inset 0 0 40px rgba(255,30,74,.14); }
    }

    .timestamp {
      font-family: var(--mono);
      font-size: .78rem; font-weight: 700;
      color: var(--muted); letter-spacing: .08em;
    }
    .timestamp span { color: var(--cyan); text-shadow: 0 0 10px rgba(0,245,255,.4); }

    /* ══ IMAGE ══ */
    .img-card { padding: 16px 18px; }
    .img-wrapper {
      width: 100%;
      border-radius: 3px;
      overflow: hidden;
      border: 1px solid rgba(0,245,255,.13);
      position: relative;
      background: #040b18;
    }
    .img-wrapper img {
      width: 100%; height: 200px;
      object-fit: cover; display: block;
      transition: transform .4s ease; opacity: .9;
    }
    .img-wrapper:hover img { transform: scale(1.03); opacity: 1; }

    /* corner brackets on image */
    .img-wrapper::before,.img-wrapper::after {
      content:''; position:absolute;
      width:20px; height:20px;
      border-color: var(--cyan); border-style:solid;
      z-index:3; opacity:.75;
    }
    .img-wrapper::before { top:6px; left:6px; border-width:2px 0 0 2px; }
    .img-wrapper::after  { bottom:6px; right:6px; border-width:0 2px 2px 0; }

    /* scan line sweep */
    .img-scan {
      position:absolute; left:0; right:0; height:2px;
      background: linear-gradient(90deg, transparent, rgba(0,245,255,.65), transparent);
      z-index:2; animation: img-sweep 3.5s linear infinite;
    }
    @keyframes img-sweep {
      0%  { top:0; opacity:1; }
      95% { top:100%; opacity:.8; }
      100%{ top:100%; opacity:0; }
    }

    .img-overlay {
      position:absolute; bottom:0; left:0; right:0;
      padding:8px 14px;
      background: linear-gradient(0deg, rgba(3,5,13,.92) 0%, transparent 100%);
      font-family: var(--mono); font-size:.65rem; font-weight:700;
      color: var(--cyan-dim); letter-spacing:.1em;
      z-index:2;
    }

    /* ══ DATA ROWS ══ */
    .data-row {
      display:flex; justify-content:space-between; align-items:center;
      padding: 11px 0;
      border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .data-row:last-child { border-bottom:none; }

    .data-key {
      font-family: var(--mono);
      font-size: .71rem; font-weight: 700;
      color: var(--muted);
      letter-spacing: .12em; text-transform: uppercase;
    }
    .data-val {
      font-family: var(--mono);
      font-size: .94rem; font-weight: 700;
      color: var(--white);
      text-shadow: 0 0 10px rgba(0,245,255,.2);
    }

    /* tags */
    .tag {
      display:inline-flex; align-items:center;
      padding: 3px 12px; border-radius:2px;
      font-family: var(--mono);
      font-size: .72rem; font-weight: 700;
      letter-spacing: .1em; text-transform: uppercase;
    }
    .tc { background:rgba(0,245,255,.09); color:var(--cyan); border:1px solid rgba(0,245,255,.28); }
    .tg { background:rgba(0,255,136,.09); color:var(--green); border:1px solid rgba(0,255,136,.28); text-shadow:0 0 8px rgba(0,255,136,.45); }
    .ty { background:rgba(255,218,0,.09); color:var(--yellow); border:1px solid rgba(255,218,0,.28); }
    .tr { background:rgba(255,30,74,.09); color:var(--red); border:1px solid rgba(255,30,74,.28); }

    /* ══ BATTERY ══ */
    .bat-row { display:flex; align-items:center; gap:14px; margin-top:6px; }
    .bat-outer {
      flex:1; height:18px;
      background: rgba(255,255,255,.04);
      border:1px solid var(--border); border-radius:2px; overflow:hidden;
      position:relative;
    }
    .bat-inner {
      height:100%; width: 0%;
      background: linear-gradient(90deg, var(--purple-dim), var(--cyan));
      box-shadow: 0 0 16px rgba(0,245,255,.35); border-radius:2px;
      position:relative;
    }
    .bat-inner::after {
      content:''; position:absolute; inset:0;
      background: linear-gradient(90deg, transparent 55%, rgba(255,255,255,.18));
      animation: bat-shine 2.4s ease-in-out infinite;
    }
    @keyframes bat-shine { 0%,100%{opacity:0;} 50%{opacity:1;} }
    .bat-pct {
      font-family: var(--hud);
      font-size:.96rem; font-weight:700;
      color:var(--cyan);
      text-shadow:0 0 12px rgba(0,245,255,.45);
      min-width:50px; text-align:right;
    }

    /* ══ ALERT ══ */
    .alert-card {
      border-color: rgba(255,30,74,.38) !important;
      background: rgba(255,30,74,.045) !important;
    }
    .alert-card::before,.alert-card::after { border-color: var(--red) !important; }
    .alert-card:hover { border-color: rgba(255,30,74,.65) !important; }

    .alert-body { display:flex; align-items:center; gap:18px; }

    .alert-icon-box {
      width:54px; height:54px; flex-shrink:0;
      border-radius:3px;
      background: rgba(255,30,74,.1);
      border:1px solid rgba(255,30,74,.35);
      display:flex; align-items:center; justify-content:center;
      font-size:1.5rem;
      animation: alert-ring 2s ease-in-out infinite;
    }
    @keyframes alert-ring {
      0%  { box-shadow:0 0 0 0 rgba(255,30,74,.45); }
      70% { box-shadow:0 0 0 14px rgba(255,30,74,0); }
      100%{ box-shadow:0 0 0 0 rgba(255,30,74,0); }
    }

    .alert-title {
      font-family: var(--hud);
      font-size:.95rem; font-weight:700;
      color: var(--red); letter-spacing:.07em; text-transform:uppercase;
      text-shadow:0 0 14px rgba(255,30,74,.5);
    }
    .alert-sub {
      font-family: var(--mono);
      font-size:.7rem; font-weight:700;
      color: var(--muted); margin-top:5px; letter-spacing:.07em;
    }

    /* ══ FOOTER ══ */
    footer {
      position:relative; z-index:5;
      text-align:center; padding:15px 20px;
      border-top:1px solid var(--border);
      font-family:var(--mono); font-size:.62rem; font-weight:700;
      color:var(--muted); letter-spacing:.18em; text-transform:uppercase;
    }
    footer span { color:var(--cyan-dim); }

    /* ══ RESPONSIVE ══ */
    @media(max-width:860px){
      main { grid-template-columns:1fr 1fr; }
      .span-3 { grid-column:1/-1; }
      .span-2 { grid-column:1/-1; }
    }
    @media(max-width:540px){
      main { grid-template-columns:1fr; }
      .span-3,.span-2 { grid-column:1; }
    }
  </style>
</head>
<body>

<div class="bg-grid"></div>
<div class="blob blob-tl"></div>
<div class="blob blob-br"></div>

<!-- ══ HEADER ══ -->
<header>
  <div class="header-top">
    <span class="hud-icon">🚆</span>
    <h1>Railway Track Monitoring System</h1>
  </div>
  <p class="header-sub">Autonomous Crack Detection &amp; Track Health Intelligence</p>
  <div class="live-row">
    <div class="live-badge"><span class="live-dot"></span>SYSTEM ONLINE</div>
    <div class="sys-chip">UNIT <span>RTM-04X</span></div>
    <div class="sys-chip">ZONE <span>SECTOR-7</span></div>
    <div class="sys-chip">MODE <span>ACTIVE SCAN</span></div>
  </div>
</header>

<!-- ══ GRID ══ -->
<main>

  <!-- STATUS -->
  <div class="card status-card span-3 status-bg-ok">
    <div class="status-eyebrow">◈ &nbsp; Track Integrity Status &nbsp; ◈</div>
    <div class="status-display s-ok">
      <span>✅</span>
      Status: OK
    </div>
    <p class="timestamp">Last Updated: &nbsp;<span>--:--:--</span></p>
  </div>

  <!-- CAMERA (2 cols) -->
  <div class="card img-card span-2">
    <div class="card-label">📷 &nbsp;Live Camera Feed</div>
    <div class="img-wrapper">
      <div class="img-scan"></div>
   <img id="camera-feed" src="/static/image.jpg" alt="Track capture"/>
      <div class="img-overlay">▶ LIVE &nbsp;·&nbsp; /static/image.jpg</div>
    </div>
  </div>

  <!-- GPS -->
  <div class="card">
    <div class="card-label">📍 &nbsp;GPS Location</div>
    <div class="data-row">
      <span class="data-key">Latitude</span>
      <span class="data-val">0°</span>
    </div>
    <div class="data-row">
      <span class="data-key">Longitude</span>
      <span class="data-val">0°</span>
    </div>
  </div>

  <!-- GSM -->
  <div class="card">
    <div class="card-label">📡 &nbsp;GSM Status</div>
    <div class="data-row">
      <span class="data-key">Network</span>
      <span class="data-val"><span class="tag tc">--</span></span>
    </div>
    <div class="data-row">
      <span class="data-key">Signal</span>
      <span class="data-val">0 dBm</span>
    </div>
  </div>

  <!-- ROBOT -->
  <div class="card">
    <div class="card-label">🤖 &nbsp;Robot Status</div>
    <div class="data-row">
      <span class="data-key">State</span>
      <span class="data-val"><span class="tag tg">--</span></span>
    </div>
    <div class="data-row">
      <span class="data-key">Recheck Count</span>
      <span class="data-val">0</span>
    </div>
  </div>

  <!-- IMU -->
  <div class="card">
    <div class="card-label">🔩 &nbsp;IMU Sensor</div>
    <div class="data-row">
      <span class="data-key">Tilt</span>
      <span class="data-val">0 °</span>
    </div>
    <div class="data-row">
      <span class="data-key">Vibration</span>
      <span class="data-val">0 m/s²</span>
    </div>
  </div>

<!-- DISTANCE SENSORS -->
<div class="card">
  <div class="card-label">📏 &nbsp;Distance Sensors</div>

  <div class="data-row">
    <span class="data-key">Ultrasonic</span>
    <span class="data-val" id="ultra">0 cm</span>
  </div>

  <div class="data-row">
    <span class="data-key">TOF</span>
    <span class="data-val" id="tof">0 mm</span>
  </div>
</div>

<div class="card">
  <div class="card-label">🧠 AI Detection</div>
  <div class="data-row">
    <span class="data-key">Result</span>
    <span class="data-val" id="ai-result">--</span>
  </div>
</div>

  <!-- BATTERY -->
  <div class="card span-3">
    <div class="card-label">🔋 &nbsp;Battery Level</div>
    <div class="bat-row">
      <div class="bat-outer">
        <div class="bat-inner"></div>
      </div>
      <span class="bat-pct">0 %</span>
    </div>
  </div>

  <!-- ALERT -->
  <div class="card alert-card span-3">
    <div class="card-label">🔔 &nbsp;Alert Log</div>
    <div class="alert-body">
      <div class="alert-icon-box">⚠️</div>
      <div>
        <div class="alert-title">⚠ Alert Sent via GSM</div>
        <div class="alert-sub">Notification dispatched to monitoring station &nbsp;·&nbsp; --:--:--</div>
      </div>
    </div>
  </div>

</main>

<footer>
  Railway Track Monitoring System &nbsp;·&nbsp;
  Autonomous Inspection Robot &nbsp;·&nbsp;
  <span>--:--:--</span>
</footer>
<script>
async function fetchStatus() {
    try {
      const response = await fetch('/api/status');     //fetch('http://192.168.1.45/data');
        const data = await response.json();

        // Status card
        const statusEl = document.querySelector('.status-display');
        statusEl.innerHTML = data.status === 'OK' ? '✅ Status: OK' : '❌ Status: CRITICAL';
        if(data.status === 'OK'){
            statusEl.classList.add('s-ok');
            statusEl.classList.remove('s-err');
        } else {
            statusEl.classList.add('s-err');
            statusEl.classList.remove('s-ok');
        }

        // Timestamps
        document.querySelectorAll('.timestamp span, footer span, .alert-sub').forEach(el => el.textContent = data.time);

        // Battery
        document.querySelector('.bat-inner').style.width = data.battery + '%';
        document.querySelector('.bat-pct').textContent = data.battery + '%';

        // GPS
        const gpsRows = document.querySelectorAll('.card')[2].querySelectorAll('.data-row .data-val');
        gpsRows[0].textContent = data.lat + '°';
        gpsRows[1].textContent = data.lon + '°';

        // GSM
        const gsmRows = document.querySelectorAll('.card')[3].querySelectorAll('.data-row');
        gsmRows[0].querySelector('.tag').textContent = data.network;
        gsmRows[1].querySelector('.data-val').textContent = data.signal + ' dBm';

        // Robot
        const robotRows = document.querySelectorAll('.card')[4].querySelectorAll('.data-row');
        robotRows[0].querySelector('.tag').textContent = data.robot_status;
        robotRows[1].querySelector('.data-val').textContent = data.recheck || 0;

        // IMU
        const imuRows = document.querySelectorAll('.card')[5].querySelectorAll('.data-row');
        imuRows[0].querySelector('.data-val').textContent = data.tilt + '°';
        imuRows[1].querySelector('.data-val').textContent = data.vibration + ' m/s²';

// Distance Sensors
document.getElementById("ultra").textContent = data.distance + " cm";
